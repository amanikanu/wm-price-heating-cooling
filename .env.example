# Public site URL used for canonical tags, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.priceheating.com

# Optional: GA4 / Tag Manager container. The GTM script only loads AFTER consent.
NEXT_PUBLIC_GTM_ID=

# Optional: call-tracking number (E.164). Real NAP stays in server markup for SEO.
NEXT_PUBLIC_CALL_TRACKING_NUMBER=

# Booking form delivery (F4). Without all three, submissions are NOT delivered;
# the confirmation screen says so explicitly instead of pretending to send.
RESEND_API_KEY=
OFFICE_EMAIL=
CONFIRMATION_FROM_EMAIL=

# Optional: submissions allowed per IP per 10 minutes (default 5). Raise only for load/E2E tests.
BOOKING_RATE_LIMIT=5

# PRODUCTION: shared rate-limit store. Without these, the limiter is per-process
# and ineffective on serverless/multi-instance hosting. Use an Upstash Redis REST
# database (or any compatible REST endpoint).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Staging only: set to true to noindex the whole site and disallow crawlers.
NEXT_PUBLIC_NOINDEX=false

# Staging/CI only: allow the form to show its honest "email not configured"
# test screen. In production, leaving the three email vars empty makes the form
# return 503 instead of pretending to accept a lead.
ALLOW_TEST_BOOKINGS=false

# Never put PII in URLs. Secrets live only in the server environment.

# Lender pre-qualification URL goes in content/financing.ts (F5), not here.
